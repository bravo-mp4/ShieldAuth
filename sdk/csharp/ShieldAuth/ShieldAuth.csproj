<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 covers .NET Core 3+/.NET 5+ and Unity 2021+, and has
         ECDsa.ImportSubjectPublicKeyInfo for signature checks. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ShieldAuth</RootNamespace>
    <PackageId>ShieldAuth</PackageId>
    <Version>2.0.0</Version>
    <Authors>MF</Authors>
    <Description>C# SDK for ShieldAuth: license validation with signed answers, HWID binding and heartbeats</Description>
    <RepositoryUrl>https://github.com/bravo-mp4/ShieldAuth</RepositoryUrl>
    <PackageTags>license;hwid;licensing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

</Project>
