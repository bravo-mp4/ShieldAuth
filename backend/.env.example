# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shieldauth

# TLS to the database: "verify" (default), "no-verify" for providers with a
# private CA (e.g. Supabase pooler), or "disable" for local Postgres.
DATABASE_SSL=disable

# Secret for signing dashboard JWTs. Use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Dashboard origin(s) allowed by CORS, comma-separated (localhost:5173 is
# always allowed outside production)
FRONTEND_URL=

# Optional
PORT=3000
JWT_EXPIRES_IN=12h
SESSION_TTL_MINUTES=30
# Proxy hops in front of the API (defaults to 1 in production)
TRUST_PROXY=

# Email (password reset and verification links)
# Dashboard URL used in links
APP_URL=http://localhost:5173
# Without a Resend key, emails are written to the log instead of sent
RESEND_API_KEY=
MAIL_FROM=ShieldAuth <onboarding@resend.dev>
